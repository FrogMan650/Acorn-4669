;- 
;- ;KbAux1Key_M: "ctrl" + "F1"
;- IF Kb_F1 && (Kb_L_Ctrl || Kb_R_Ctrl) && AllowKbInput_M THEN (KbAux1Key_M)
;- 
;- ;KbAux2Key_M: "ctrl" + "F2"
;- IF Kb_F2 && (Kb_L_Ctrl || Kb_R_Ctrl) && AllowKbInput_M THEN (KbAux2Key_M)
